commands:
  01_install_mongodb_ext:
    command: |
      if ! php -m 2>/dev/null | grep -q "^mongodb$"; then
        yum install -y php-pecl-mongodb 2>/dev/null || \
        dnf install -y php-pecl-mongodb 2>/dev/null || \
        (pecl install mongodb && echo "extension=mongodb.so" > /etc/php.d/50-mongodb.ini)
      fi
    ignoreErrors: false
